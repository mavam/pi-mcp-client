{
  "name": "pi-mcp-client",
  "version": "0.11.0",
  "description": "MCP tools for Pi, discovered on demand and called natively through the official SDK.",
  "type": "module",
  "license": "MIT",
  "author": "Matthias Vallentin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mavam/pi-mcp-client.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "mcp",
    "model-context-protocol"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./durable": {
      "types": "./dist/durable.d.ts",
      "import": "./dist/durable.js"
    }
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-durable": {
      "optional": true
    },
    "@earendil-works/chord": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && esbuild src/index.ts src/durable.ts --bundle --splitting --format=esm --platform=node --outdir=dist --external:@earendil-works/pi-durable --external:@earendil-works/chord --external:@earendil-works/pi-coding-agent --external:@earendil-works/pi-ai --external:@earendil-works/pi-tui --external:typebox --external:@modelcontextprotocol/client --external:@modelcontextprotocol/client/* --external:@napi-rs/keyring && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && bun test",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@napi-rs/keyring": "^1.3.0",
    "jose": "^6.1.3",
    "minisearch": "^7.2.0",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@earendil-works/chord": "^1.0.0",
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-durable": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "@modelcontextprotocol/server": "2.1.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.0",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-durable": "^1.0.0",
    "@earendil-works/chord": "^1.0.0",
    "@earendil-works/pi-ai": ">=0.99.0",
    "@earendil-works/pi-coding-agent": ">=0.99.0",
    "@earendil-works/pi-tui": ">=0.99.0",
    "typebox": "*"
  }
}
