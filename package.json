{
  "name": "pi-mcp-client",
  "version": "0.3.2",
  "description": "MCP tools for Pi, discovered on demand and called natively through the official SDK.",
  "type": "module",
  "license": "MIT",
  "author": "Matthias Vallentin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mavam/pi-mcp-client.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "mcp",
    "model-context-protocol"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && esbuild src/index.ts --bundle --format=esm --platform=node --outfile=dist/index.js --external:@earendil-works/pi-coding-agent --external:@earendil-works/pi-ai --external:@earendil-works/pi-tui --external:typebox --external:@modelcontextprotocol/client --external:@modelcontextprotocol/client/* --external:@napi-rs/keyring",
    "check": "tsc --noEmit && bun test",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@napi-rs/keyring": "^1.3.0",
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typebox": "^1.1.0",
    "typescript": "^5.9.0",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.85.1",
    "@earendil-works/pi-coding-agent": ">=0.85.1",
    "@earendil-works/pi-tui": ">=0.85.1",
    "typebox": "^1.1.0"
  }
}
